# BoilerScout environment — copy to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env`.

# Typesense Cloud (required for live search + ingestion)
TYPESENSE_HOST=
TYPESENSE_ADMIN_KEY=
TYPESENSE_SEARCH_KEY=

# Mapbox (RouteScout walking directions; optional public map token)
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
